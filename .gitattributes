# Единые переводы строк: в репозитории LF, в рабочем дереве — родные для ОС
* text=auto eol=lf

# Скрипты, зависящие от платформы
*.ps1 text eol=crlf
*.bat text eol=crlf
*.sh  text eol=lf

# Бинарные — не трогать
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.zip binary
*.pkl binary
*.npz binary
*.stl binary
*.mp4 binary
*.onnx binary
*.pdf binary
