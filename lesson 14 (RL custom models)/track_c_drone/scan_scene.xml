<mujoco model="drone_scanner">
  <!--
  ==========================================================================
  СЦЕНА СКАНИРОВАНИЯ (ступень C2)
  ==========================================================================
  Дрон тот же, что в quad.xml (масса 0.740 кг, 4 винта, tau 0.02 с);
  отличий два — добавлен сайт камеры `cam` и объект съёмки.

  ОБЪЕКТ СЪЁМКИ спроектирован под задачу покрытия, а не «чтобы был домик»:

    tower  1.8 x 1.4 x 3.6 м   — основной массив, 4 стены = основная часть
                                 из 96 ячеек развёртки;
    ledge  2.6 x 0.7 x 0.5 м   — ВЫСТУП. Без него задача вырождается:
                                 любой облёт по окружности берёт 100 %
                                 покрытия, и обученная политика ничем
                                 не отличается от скриптовой. Выступ даёт
                                 самозатенение — под него надо ПОДЛЕТЕТЬ,
                                 и именно на нём кончаются последние ~10 %;
    cap    2.0 x 1.6 x 0.24 м  — «шапка» крыши: свес, из-за которого верхнюю
                                 полосу стен не видно сверху.

  Размеры <geom> в MuJoCo — ПОЛУразмеры, поэтому size="0.9 0.7 1.8"
  это коробка 1.8 x 1.4 x 3.6 м. Ошибка «забыл про половину» — самая частая
  при чтении чужого MJCF.

  Развёртка покрытия (16 секторов x 6 полос = 96 ячеек) строится в scan_env.py
  по цилиндру вокруг этого объекта; если правите размеры tower — правьте
  и константы Z_LO/Z_HI/R_HIT_MAX там же, иначе часть ячеек станет
  недостижимой, а это тихий брак: политика будет вечно недобирать покрытие,
  и виноватой назначат награду.
  ==========================================================================
  -->

  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"
          density="1.204" viscosity="1.8e-5"/>
  <!-- 8M, а не 4M как в quad.xml: геомов и потенциальных контактных пар больше -->
  <size memory="8M"/>

  <visual>
    <global offwidth="1280" offheight="960"/>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35"/>
  </visual>

  <default>
    <geom condim="3" friction="0.8 0.005 0.0001"/>
    <default class="visual">
      <geom contype="0" conaffinity="0" density="0"/>
    </default>
  </default>

  <asset>
    <material name="ground"   rgba="0.30 0.32 0.34 1"/>
    <material name="building" rgba="0.62 0.60 0.56 1"/>
    <material name="roof"     rgba="0.45 0.42 0.40 1"/>
    <material name="core"     rgba="0.20 0.22 0.26 1"/>
    <material name="arm"      rgba="0.45 0.47 0.50 1"/>
    <material name="cw"       rgba="0.90 0.25 0.20 1"/>
    <material name="ccw"      rgba="0.20 0.55 0.90 1"/>
  </asset>

  <worldbody>
    <light name="sun" pos="0 0 12" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>

    <!-- overview: общий план. Прежняя камера стояла на 10 -10 8 и давала
         дрон размером в несколько пикселей; 6 -6 4.5 держит башню на 2/3
         кадра и дрон различимым.
         chase: летит за дроном (trackcom) — для гифки облёта. -->
    <camera name="overview" mode="fixed" pos="6 -6 4.5"
            xyaxes="0.707 0.707 0 -0.40 0.40 0.82"/>
    <camera name="chase" mode="trackcom" pos="-3.0 -3.0 1.8"
            xyaxes="0.707 -0.707 0 0.35 0.35 0.87"/>

    <geom name="floor" type="plane" size="20 20 0.2" material="ground"/>

    <body name="target_obj" pos="0 0 0">
      <geom name="tower" type="box" size="0.9 0.7 1.8"  pos="0 0 1.8"  material="building"/>
      <geom name="ledge" type="box" size="1.3 0.35 0.25" pos="0 0.9 2.3" material="building"/>
      <geom name="cap"   type="box" size="1.0 0.8 0.12"  pos="0 0 3.72" material="roof"/>
    </body>

    <body name="drone" pos="4 0 1.5">
      <freejoint name="root"/>
      <geom name="core" type="box" size="0.06 0.06 0.015" mass="0.42" material="core"/>
      <geom name="arm_a" type="capsule" fromto="-0.092 -0.092 0  0.092  0.092 0" size="0.008" mass="0.05" material="arm"/>
      <geom name="arm_b" type="capsule" fromto="-0.092  0.092 0  0.092 -0.092 0" size="0.008" mass="0.05" material="arm"/>
      <geom name="m1" type="cylinder" pos=" 0.092 -0.092 0.012" size="0.018 0.012" mass="0.055" material="ccw"/>
      <geom name="m2" type="cylinder" pos="-0.092  0.092 0.012" size="0.018 0.012" mass="0.055" material="ccw"/>
      <geom name="m3" type="cylinder" pos=" 0.092  0.092 0.012" size="0.018 0.012" mass="0.055" material="cw"/>
      <geom name="m4" type="cylinder" pos="-0.092 -0.092 0.012" size="0.018 0.012" mass="0.055" material="cw"/>
      <site name="rotor1" pos=" 0.092 -0.092 0.024" size="0.01"/>
      <site name="rotor2" pos="-0.092  0.092 0.024" size="0.01"/>
      <site name="rotor3" pos=" 0.092  0.092 0.024" size="0.01"/>
      <site name="rotor4" pos="-0.092 -0.092 0.024" size="0.01"/>
      <site name="imu"    pos="0 0 0" size="0.005"/>
      <!-- cam: начало координат камеры съёмки. Ось X сайта = направление
           взгляда, поэтому веер лучей в scan_env.py строится вокруг +X.
           Сайт стоит на 8 см впереди центра и на уровне z = 0, то есть ПОД
           геомом `nose` (он от z = 0.018 до z = 0.026) и впереди гондол.
           Проверено: ни один из 15 лучей не попадает в геомы самого аппарата
           даже без bodyexclude. Но bodyexclude в коде всё равно стоит —
           сдвиг камеры на сантиметр не должен превращать сенсор в измеритель
           расстояния до собственного носа. -->
      <site name="cam"    pos="0.08 0 0" size="0.006"/>
      <geom name="nose" class="visual" type="box" size="0.05 0.008 0.004" pos="0.07 0 0.022" material="cw"/>
    </body>
  </worldbody>

  <actuator>
    <!-- параметры винтов дословно те же, что в quad.xml: k_m = 0.0165 м,
         ctrlrange 0..4.6 Н, tau = 0.02 с. Так политика C1 и внутренний контур
         C0 работают на этой сцене без единой правки. -->
    <general name="thrust1" site="rotor1" ctrlrange="0 4.6" gear="0 0 1 0 0 -0.0165"
             dyntype="filterexact" dynprm="0.02" gaintype="fixed" gainprm="1" biastype="none"/>
    <general name="thrust2" site="rotor2" ctrlrange="0 4.6" gear="0 0 1 0 0 -0.0165"
             dyntype="filterexact" dynprm="0.02" gaintype="fixed" gainprm="1" biastype="none"/>
    <general name="thrust3" site="rotor3" ctrlrange="0 4.6" gear="0 0 1 0 0  0.0165"
             dyntype="filterexact" dynprm="0.02" gaintype="fixed" gainprm="1" biastype="none"/>
    <general name="thrust4" site="rotor4" ctrlrange="0 4.6" gear="0 0 1 0 0  0.0165"
             dyntype="filterexact" dynprm="0.02" gaintype="fixed" gainprm="1" biastype="none"/>
  </actuator>

  <sensor>
    <framequat name="s_quat" objtype="site" objname="imu"/>
    <gyro name="s_gyro" site="imu"/>
  </sensor>
</mujoco>
